{
  "$description": "MT Seller Dashboard tokens (W3C Design Tokens format). Same values as the 'MT Seller Dashboard' Design System artifact; change both together. Source: manitechnology.com Amazon section, adjusted for WCAG 2.2 AA.",
  "color": {
    "$type": "color",
    "surface": {
      "page": { "$value": "#ffffff", "$description": "Content ground, panels, tables, controls" },
      "sky": { "$value": "#e4eeff", "$description": "Top of the 360px page band gradient" },
      "side": { "$value": "#f7faff", "$description": "Sidebar and table header row" },
      "sunken": { "$value": "#edf2f9", "$description": "Segmented track, panel borders, row rules" },
      "hover": { "$value": "#eef4fd", "$description": "Hover ground for nav links and rows" }
    },
    "line": {
      "default": { "$value": "#dce5f2", "$description": "Control borders with text labels, chart baselines" },
      "strong": { "$value": "#7a8aa3", "$description": "Text and date input borders (3.5:1)" }
    },
    "ink": {
      "default": { "$value": "#04182f", "$description": "Main text (17.8:1)" },
      "2": { "$value": "#4a5c7c", "$description": "Secondary text, table numbers (6.8:1)" },
      "3": { "$value": "#5a6984", "$description": "Quiet labels; 4.7:1 on surface.sky" },
      "disabled": { "$value": "#8a97ad", "$description": "Disabled control text only" }
    },
    "accent": {
      "default": { "$value": "#0078f0", "$description": "Chart series 1, marks only (not small text)" },
      "strong": { "$value": "#0057c8", "$description": "Links, primary buttons, active nav, positive change, focus (6.6:1)" },
      "strong-hover": { "$value": "#00479f", "$description": "Primary button hover" },
      "soft": { "$value": "#eaf3ff", "$description": "Selected chips" }
    },
    "violet": { "$value": "#783fee", "$description": "Chart series 2, gradient end" },
    "chart": {
      "bar-soft": { "$value": "#a9c6f5", "$description": "Bars that are not highlighted" },
      "bar-cost": { "$value": "#c9d6ea", "$description": "Cost steps in the profit waterfall" }
    },
    "switch-off": { "$value": "#7a8aa3", "$description": "Switch track when off (3.5:1)" },
    "skeleton": { "$value": "#e8eef7", "$description": "Loading blocks" },
    "critical": {
      "default": { "$value": "#b42339", "$description": "Loss, out of stock, ACoS above target (6.5:1)" },
      "soft": { "$value": "#fdecee", "$description": "Critical flag ground, out-of-stock band" }
    },
    "warning": {
      "default": { "$value": "#8a5300", "$description": "Low stock, spend with no sales (6.3:1)" },
      "soft": { "$value": "#fff3dc", "$description": "Warning flag ground" }
    },
    "toast": {
      "ground": { "$value": "{color.ink.default}", "$description": "Toast background" },
      "icon": { "$value": "#7fb6ff", "$description": "Toast check icon (8.5:1 on ground)" }
    }
  },
  "gradient": {
    "brand": {
      "$type": "gradient",
      "$value": [
        { "color": "{color.accent.default}", "position": 0 },
        { "color": "{color.violet}", "position": 0.96 }
      ],
      "$description": "KPI numbers, net-profit bar, store mark; drawn at 168deg"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Plus Jakarta Sans Variable", "Plus Jakarta Sans", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "SIL OFL, self-hosted from @fontsource-variable/plus-jakarta-sans" },
      "mono": { "$value": ["JetBrains Mono Variable", "JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$description": "SIL OFL, self-hosted from @fontsource-variable/jetbrains-mono" }
    }
  },
  "typography": {
    "$type": "typography",
    "page-title": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "26px", "fontWeight": 700, "lineHeight": 1.15, "letterSpacing": "-0.02em" }, "$description": "22px at phone width" },
    "kpi-number": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "26px", "fontWeight": 600, "lineHeight": 1, "letterSpacing": "-0.02em" }, "$description": "Tabular, brand gradient; 22px at phone width" },
    "section-title": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "15px", "fontWeight": 600, "lineHeight": 1.35, "letterSpacing": "0" } },
    "body": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" } },
    "small": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.45, "letterSpacing": "0" } },
    "caption": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "12.5px", "fontWeight": 400, "lineHeight": 1.4, "letterSpacing": "0" } },
    "table-number": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.45, "letterSpacing": "0" }, "$description": "Tabular, right aligned" },
    "chart-label": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "11px", "fontWeight": 400, "lineHeight": 1.3, "letterSpacing": "0.12em" }, "$description": "Uppercase; chart ticks, legends, scope tags only (exception Q8)" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px", "$description": "Nav links, segmented buttons" },
    "md": { "$value": "10px", "$description": "Filter controls, buttons, segmented track" },
    "lg": { "$value": "12px", "$description": "Tiles, panels, tables, toasts" },
    "pill": { "$value": "999px", "$description": "Flags, pills, switch" }
  },
  "shadow": {
    "$type": "shadow",
    "tile": {
      "$value": [
        { "color": "#fffffff2", "offsetX": "0px", "offsetY": "1px", "blur": "0px", "spread": "0px", "inset": true },
        { "color": "#04182f0d", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px" },
        { "color": "#04182f52", "offsetX": "0px", "offsetY": "20px", "blur": "44px", "spread": "-30px" }
      ],
      "$description": "KPI tiles only"
    },
    "raised": {
      "$value": [
        { "color": "#0f172a0f", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#04182f0d", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px" }
      ],
      "$description": "Active nav link, selected segmented button"
    },
    "toast": {
      "$value": { "color": "#04182f99", "offsetX": "0px", "offsetY": "20px", "blur": "44px", "spread": "-24px" }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "press": { "$value": "120ms" },
      "ui": { "$value": "160ms" },
      "enter": { "$value": "180ms" },
      "step": { "$value": "200ms", "$description": "Each bar of the profit waterfall" },
      "stagger": { "$value": "110ms", "$description": "Delay between waterfall bars" },
      "pulse": { "$value": "1400ms", "$description": "Skeleton pulse, alternating" }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.2, 0.7, 0.2, 1], "$description": "All UI motion; no bounce" }
    }
  }
}
